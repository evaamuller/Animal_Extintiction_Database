    "%%sql\n",
    "\n",
    "CREATE TABLE IF NOT EXISTS Animal (\n",
    "    animal_id INT PRIMARY KEY AUTO_INCREMENT,\n",
    "    genus_name VARCHAR(100) NOT NULL,\n",
    "    species_name VARCHAR(100) NOT NULL,\n",
    "    common_name VARCHAR(100),\n",
    "    animal_class VARCHAR(15),\n",
    "    diet VARCHAR(15),\n",
    "    native BOOLEAN DEFAULT TRUE\n",
    ");\n",
    "\n",
    "ALTER TABLE Animal ADD CONSTRAINT unique_animal_name UNIQUE(genus_name,species_name);\n",
    "ALTER TABLE Animal ADD CONSTRAINT check_animal_class CHECK (animal_class IN ('Mammalia', 'Aves', 'Reptilia', 'Amphibia', 'Actinopterygii', 'Elasmobranchii', 'Insecta', 'Arachnida', 'Malacostraca', 'Gastropoda', 'Bivalvia', 'Annelida'));\n",
    "ALTER TABLE Animal ADD CONSTRAINT check_diet CHECK (diet IN ('Carnivore', 'Herbivore', 'Omnivore', 'Frugivore', 'Granivore', 'Foliovore', 'Nectarivore', 'Insectivore', 'Piscivore', 'Myrmecovore', 'Detritivore', 'Scavenger'));"
   ]
  },
